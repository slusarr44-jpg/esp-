-- Menu Toggle
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == CONFIG.MENU_KEY then
        CONFIG.MENU_VISIBLE = not CONFIG.MENU_VISIBLE
        menuFrame.Visible = CONFIG.MENU_VISIBLE
    end
end)

-- ESP Rendering Loop
local espBoxes = {}

RunService.RenderStepped:Connect(function()
    if not CONFIG.ESP_ENABLED then
        for _, box in pairs(espBoxes) do
            box:Remove()
        end
        espBoxes = {}
        return
    end
    
    local currentColor = COLORS[CONFIG.ESP_COLOR_INDEX].rgb
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == Players.LocalPlayer then continue end
        
        local character = player.Character
        if not character then continue end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then continue end
        
        local screenPos, onScreen = Camera:WorldToScreenPoint(humanoidRootPart.Position)
        
        if onScreen then
            local boxName = "ESP_" .. player.UserId
            local box = espBoxes[boxName]
            
            if not box then
                box = Drawing.new("Square")
                box.Visible = true
                box.Filled = false
                box.Thickness = CONFIG.ESP_THICKNESS
                espBoxes[boxName] = box
            end
            
            box.Color = currentColor
            box.Position = Vector2.new(screenPos.X - 25, screenPos.Y - 30)
            box.Size = Vector2.new(50, 60)
        end
    end
    
    for boxName, box in pairs(espBoxes) do
        local userId = tonumber(boxName:match("(%d+)$"))
        if not Players:FindFirstChild(tostring(userId)) then
            box:Remove()
            espBoxes[boxName] = nil
        end
    end
end)

print("[ESP Cheat] Loaded. Press INSERT to toggle menu.")
