    if gameProcessed then return end
    if input.KeyCode == CONFIG.MENU_KEY then
        CONFIG.MENU_VISIBLE = not CONFIG.MENU_VISIBLE
        menuFrame.Visible = CONFIG.MENU_VISIBLE
    end
end)

-- ESP Rendering
local espBoxes = {}

RunService.RenderStepped:Connect(function()
    if not CONFIG.ESP_ENABLED then
        for _, box in pairs(espBoxes) do
            if box then pcall(function() box:Remove() end) end
        end
        espBoxes = {}
        return
    end
    
    local currentColor = COLORS[CONFIG.ESP_COLOR_INDEX].rgb
    local players = Players:GetPlayers()
    
    for _, player in pairs(players) do
        if player == Players.LocalPlayer then continue end
        
        local character = player.Character
        if not character then continue end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local hrp = character:FindFirstChild("HumanoidRootPart")
        
        if not hrp or not humanoid or humanoid.Health <= 0 then continue end
        
        local screenPos, onScreen = Camera:WorldToScreenPoint(hrp.Position)
        
        if onScreen then
            local boxKey = "ESP_" .. player.UserId
            local box = espBoxes[boxKey]
            
            if not box then
                box = Drawing.new("Square")
                box.Visible = true
                box.Filled = false
                box.Thickness = CONFIG.ESP_THICKNESS
                espBoxes[boxKey] = box
            end
            
            local boxSize = math.max(30, 1000 / (Camera.CFrame.Position - hrp.Position).Magnitude)
            
            box.Color = currentColor
            box.Position = Vector2.new(screenPos.X - boxSize/2, screenPos.Y - boxSize/2)
            box.Size = Vector2.new(boxSize, boxSize * 1.3)
        end
    end
    
    -- Cleanup dead/left players
    for boxKey, box in pairs(espBoxes) do
        local userId = tonumber(boxKey:match("(%d+)$"))
        local playerExists = false
        
        for _, p in pairs(players) do
            if p.UserId == userId then
                playerExists = true
                break
            end
        end
        
        if not playerExists then
            pcall(function() box:Remove() end)
            espBoxes[boxKey] = nil
        end
    end
end)

