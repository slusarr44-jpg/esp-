local Camera = workspace.CurrentCamera

-- CONFIG
local CONFIG = {
    ESP_ENABLED = true,
    ESP_COLOR_INDEX = 1, -- 1=зелёный, 2=красный, 3=чёрный, 4=белый, 5=розовый
    ESP_THICKNESS = 2,
    MENU_KEY = Enum.KeyCode.Insert,
    MENU_VISIBLE = true
