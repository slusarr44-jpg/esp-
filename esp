-- ============ ESP РЕНДЕР (Box + Skeleton) ============

local drawings = {}

local function drawLine(p1, p2, color, thickness)
    if not Drawing then return end
    local line = Drawing.new("Line")
    line.Visible = true
    line.Color = color
    line.Thickness = thickness
    line.From = p1
    line.To = p2
    table.insert(drawings, line)
    return line
end

local function drawBox(pos, size, color, thickness)
    if not Drawing then return end
    local box = Drawing.new("Square")
    box.Visible = true
    box.Filled = false
    box.Color = color
    box.Thickness = thickness
    box.Position = pos
    box.Size = size
    table.insert(drawings, box)
    return box
end

local function worldToScreen(position)
    local screenPos, visible = Camera:WorldToScreenPoint(position)
    return Vector2.new(screenPos.X, screenPos.Y), visible
end

RunService.RenderStepped:Connect(function()
    if not CONFIG.ESP_ENABLED then
        for _, drawing in pairs(drawings) do
            pcall(function() drawing:Remove() end)
        end
        drawings = {}
        return
    end
    
    if not Drawing then return end
    
    for _, drawing in pairs(drawings) do
        pcall(function() drawing:Remove() end)
    end
    drawings = {}
    
    local currentColor = COLORS[CONFIG.COLOR_INDEX].value
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        if not char then continue end
        
        local humanoid = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if not hrp or not humanoid or humanoid.Health <= 0 then continue end
        
        local hrmPos, hrmVis = worldToScreen(hrp.Position)
        if not hrmVis then continue end
        
        -- ===== BOX (обводка тела) =====
        if CONFIG.BOX_ENABLED then
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            local boxSize = math.clamp(800 / dist, 40, 160)
            
            drawBox(hrmPos - Vector2.new(boxSize/2, boxSize/2), Vector2.new(boxSize, boxSize * 1.3), currentColor, 2)
        end
        
        -- ===== SKELETON (линии скелета) =====
        if CONFIG.SKELETON_ENABLED then
            for _, connection in ipairs(SKELETON_CONNECTIONS) do
                local part1Name, part2Name = connection[1], connection[2]
                local part1 = char:FindFirstChild(part1Name)
                local part2 = char:FindFirstChild(part2Name)
                
                if part1 and part2 then
                    local pos1, vis1 = worldToScreen(part1.Position)
                    local pos2, vis2 = worldToScreen(part2.Position)
                    
                    if vis1 and vis2 then
                        drawLine(pos1, pos2, currentColor, 1.5)
                    end
                end
            end
        end
    end
end)

