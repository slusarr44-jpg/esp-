-- Color Selection Buttons
local colorButtonPositions = {
    {pos = 130, name = "Green"},
    {pos = 160, name = "Red"},
    {pos = 190, name = "Black"},
    {pos = 220, name = "White"},
    {pos = 250, name = "Pink"}
}

for i, colorData in ipairs(colorButtonPositions) do
    local colorButton = Instance.new("TextButton")
    colorButton.Name = "Color_" .. colorData.name
    colorButton.Size = UDim2.new(1, -10, 0, 25)
    colorButton.Position = UDim2.new(0, 5, 0, colorData.pos)
    colorButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    colorButton.TextColor3 = COLORS[i].rgb
    colorButton.Text = "Color: " .. COLORS[i].name
    colorButton.TextSize = 11
    colorButton.Font = Enum.Font.Gotham
    colorButton.Parent = menuFrame
    
    colorButton.MouseButton1Click:Connect(function()
        CONFIG.ESP_COLOR_INDEX = i
    end)
end

