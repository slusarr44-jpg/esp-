    modeBtn.Text = mode.name
    modeBtn.TextSize = 12
    modeBtn.Font = Enum.Font.Gotham
    modeBtn.BorderSizePixel = 0
    modeBtn.Parent = menuWindow
    
    modeBtn.MouseButton1Click:Connect(function()
        CONFIG.MODE = mode.value
        -- Обновить все кнопки
        for _, child in pairs(menuWindow:GetChildren()) do
            if child:IsA("TextButton") and (child.Text == "Box" or child.Text == "Skeleton" or child.Text == "Both") then
                if child.Text == mode.name then
                    child.BackgroundColor3 = Color3.fromRGB(70, 100, 150)
