local modes = {
    {name = "Box", value = "box"},
    {name = "Skeleton", value = "skeleton"},
    {name = "Both", value = "both"}
}

for i, mode in ipairs(modes) do
    local modeBtn = Instance.new("TextButton")
    modeBtn.Size = UDim2.new(1, -20, 0, 35)
    modeBtn.Position = UDim2.new(0, 10, 0, 120 + (i-1) * 40)
    modeBtn.BackgroundColor3 = (mode.value == "box") and Color3.fromRGB(70, 100, 150) or Color3.fromRGB(50, 50, 60)
