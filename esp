-- ============ ESP RENDERING ============

local renderedObjects = {}

local function clearAll()
    for _, obj in pairs(renderedObjects) do
        pcall(function() obj:Remove() end)
    end
    renderedObjects = {}
end

local function worldToScreen(pos)
    local screenPos, onScreen = Camera:WorldToScreenPoint(pos)
    return Vector2.new(screenPos.X, screenPos.Y), onScreen
end

local function drawESP()
    clearAll()
    
    if not CONFIG.ESP_ENABLED or not Drawing then return end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local character = player.Character
        if not character then continue end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        
        if not humanoidRootPart or not humanoid or humanoid.Health <= 0 then continue end
        
        local screenPos, isOnScreen = worldToScreen(humanoidRootPart.Position)
        if not isOnScreen then continue end
        
        -- BOX MODE
        if CONFIG.BOX_MODE then
            local distance = (Camera.CFrame.Position - humanoidRootPart.Position).Magnitude
            local size = math.clamp(1500 / distance, 50, 200)
            
            local box = Drawing.new("Square")
            box.Visible = true
            box.Color = CONFIG.COLOR
            box.Thickness = 2
            box.Filled = false
            box.Position = screenPos - Vector2.new(size / 2, size / 2)
            box.Size = Vector2.new(size, size * 1.5)
            table.insert(renderedObjects, box)
        end
        
        -- SKELETON MODE
        if CONFIG.SKELETON_MODE then
            for _, bone in ipairs(BONES) do
                local part1 = character:FindFirstChild(bone[1])
                local part2 = character:FindFirstChild(bone[2])
                
                if part1 and part2 then
                    local pos1, vis1 = worldToScreen(part1.Position)
                    local pos2, vis2 = worldToScreen(part2.Position)
                    
                    if vis1 and vis2 then
                        local line = Drawing.new("Line")
                        line.Visible = true
                        line.Color = CONFIG.COLOR
                        line.Thickness = 1.5
                        line.From = pos1
                        line.To = pos2
                        table.insert(renderedObjects, line)
                    end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    drawESP()
end)

