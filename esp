    local colorBtn = Instance.new("TextButton")
    colorBtn.Size = UDim2.new(0.4, -8, 0, 30)
    colorBtn.Position = UDim2.new(((i-1) % 2) * 0.5 + 0.05, 0, 0, 270 + math.floor((i-1)/2) * 35)
    colorBtn.BackgroundColor3 = (i == 1) and Color3.fromRGB(80, 120, 180) or Color3.fromRGB(50, 50, 60)
    colorBtn.BackgroundTransparency = 0.25
    colorBtn.TextColor3 = color.rgb
    colorBtn.Text = color.name
    colorBtn.TextSize = 10
    colorBtn.Font = Enum.Font.Gotham
    colorBtn.BorderSizePixel = 0
    colorBtn.Parent = menuWindow
    
    colorBtn.MouseButton1Click:Connect(function()
        CONFIG.COLOR_INDEX = i
        for _, child in pairs(menuWindow:GetChildren()) do
            if child:IsA("TextButton") and (child.Text == "Green" or child.Text == "Red" or child.Text == "Cyan" or child.Text == "White" or child.Text == "Pink") then
                local found = false
                for j, c in ipairs(COLORS) do
                    if c.name == child.Text and j == i then
                        child.BackgroundColor3 = Color3.fromRGB(80, 120, 180)
                        found = true
                        break
                    end
                end
                if not found then
                    child.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
                end
            end
        end
    end)
    
    colorBtn.Name = color.name .. "ColorBtn"
end

print("[ESP] Меню готово")

-- ============ ESP РЕНДЕР ============

local allDrawings = {}

local function clearDrawings()
    for _, d in pairs(allDrawings) do
        pcall(function() d:Remove() end)
    end
    allDrawings = {}
end

local function drawLine(from, to, color, thick)
    if not Drawing then return end
    local line = Drawing.new("Line")
    line.Visible = true
    line.From = from
    line.To = to
    line.Color = color
    line.Thickness = thick
    table.insert(allDrawings, line)
end

local function drawBox(pos, size, color, thick)
    if not Drawing then return end
    local box = Drawing.new("Square")
    box.Visible = true
    box.Filled = false
    box.Position = pos
    box.Size = size
    box.Color = color
    box.Thickness = thick
    table.insert(allDrawings, box)
end

local function worldToScreen(pos)
    local screen, vis = Camera:WorldToScreenPoint(pos)
    return Vector2.new(screen.X, screen.Y), vis
end

RunService.RenderStepped:Connect(function()
    clearDrawings()
    
    if not CONFIG.ENABLED or not Drawing then return end
    
    local color = COLORS[CONFIG.COLOR_INDEX].rgb
    
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        if not char then continue end
        
        local humanoid = char:FindFirstChild("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")
        
        if not hrp or not humanoid or humanoid.Health <= 0 then continue end
        
        local screenPos, onScreen = worldToScreen(hrp.Position)
        if not onScreen then continue end
        
        -- BOX режим
        if CONFIG.MODE == "box" or CONFIG.MODE == "both" then
            local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
            local size = math.clamp(1000 / dist, 50, 180)
            drawBox(screenPos - Vector2.new(size/2, size/2), Vector2.new(size, size * 1.4), color, 2)
        end
        
        -- SKELETON режим
        if CONFIG.MODE == "skeleton" or CONFIG.MODE == "both" then
            for _, bone in ipairs(BONES) do
                local p1 = char:FindFirstChild(bone[1])
                local p2 = char:FindFirstChild(bone[2])
                if p1 and p2 then
                    local s1, v1 = worldToScreen(p1.Position)
                    local s2, v2 = worldToScreen(p2.Position)
                    if v1 and v2 then
                        drawLine(s1, s2, color, 1.5)
                    end
                end
            end
        end
    end
end)

